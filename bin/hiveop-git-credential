#!/bin/sh
# hiveop-git-credential <api-base> <workspace-id> <get|store|erase>
#
# A git credential helper for a HiveOp cloud repo (hcp-26). On `get` it asks the
# HiveOp API for a fresh 15-minute git token and hands it to git over stdout.
# `store` and `erase` do nothing: nothing is ever cached or written to disk.
#
# The Plugin key is read here, by this process, from the plugin's own key file
# (~/.hiveop/claude-plugin.json, readable by you only). It is never printed, never
# put on a command line (curl reads its headers from stdin) and never logged.
# The only stderr lines are fixed words. Nothing but username=/password= goes to
# stdout: anything else would corrupt git's parse.

api="${1:-}"
ws="${2:-}"
verb="${3:-}"

# git always sends the credential description on stdin; drain it.
cat >/dev/null 2>&1

[ "$verb" = "get" ] || exit 0

fail() {
  echo "hiveop-git-credential: $1" >&2
  exit 1
}

case "$api" in
  https://*|http://*) ;;
  *) fail "bad api address" ;;
esac
case "$api" in
  *[!A-Za-z0-9:/._-]*) fail "bad api address" ;;
esac
case "$ws" in
  ''|*[!A-Za-z0-9-]*) fail "bad workspace" ;;
esac

file="${HOME:-}/.hiveop/claude-plugin.json"
key="$(sed -n 's/.*"key"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file" 2>/dev/null | head -n 1)"
[ -n "$key" ] || fail "not signed in"
case "$key" in
  *[!A-Za-z0-9_.-]*) fail "not signed in" ;;
esac

# The key rides on curl's stdin (--config -), so `ps` never shows it.
out="$(printf 'url = "%s/workspaces/%s/repo-credential"\nheader = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\nheader = "X-HiveOp-Client: claude-code-plugin"\n' "$api" "$ws" "$key" \
  | curl -sS --max-time 15 --config - -X POST --data '{}' -w '\n%{http_code}' 2>/dev/null)" || fail "unavailable"
key=""

status="${out##*
}"
body="${out%
*}"

case "$status" in
  200) ;;
  401) fail "revoked" ;;
  403)
    case "$body" in
      *REPO_ACCESS_NOT_GRANTED*) fail "revoked" ;;
      *) fail "refused" ;;
    esac
    ;;
  *) fail "unavailable" ;;
esac

username="$(printf '%s' "$body" | sed -n 's/.*"username"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
token="$(printf '%s' "$body" | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
[ -n "$username" ] && [ -n "$token" ] || fail "unavailable"
case "$username$token" in
  *[!A-Za-z0-9_.-]*) fail "unavailable" ;;
esac

printf 'username=%s\npassword=%s\n' "$username" "$token"
